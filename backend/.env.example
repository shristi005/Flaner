PORT=3000

# ---------- Login + saved progress (REQUIRED) ----------
# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY          # public by design; protected by row-level security
# Optional: lets people delete their own account from the profile page.
# This key is SECRET. Server-side only. Never put it in the frontend or commit it.
# SUPABASE_SERVICE_ROLE_KEY=

# Only needed if the frontend is hosted on a different address than this server:
# ALLOWED_ORIGINS=https://your-frontend.example.com
# Development only, skips login. Never enable on a hosted server:
# ALLOW_LOCAL_MODE=true
# HOST=0.0.0.0   # hosted servers listen on all interfaces by default

# ---------- AI model (open-weight; Ollama by default) ----------
# Install Ollama (ollama.com), then run:  ollama pull qwen2.5:7b
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_JSON_MODE=false

# Other open-weight options (OpenAI-compatible: change these 3 lines):
#  LM Studio / llama.cpp / vLLM:  LLM_BASE_URL=http://localhost:1234/v1   LLM_MODEL=<model name>
#  Hugging Face:  LLM_BASE_URL=https://router.huggingface.co/v1   LLM_API_KEY=hf_...   LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
#  DeepSeek:      LLM_BASE_URL=https://api.deepseek.com/v1        LLM_API_KEY=...      LLM_MODEL=deepseek-chat
#  (check each provider's docs for current model names)

# ---------- Reflection model (OPTIONAL, separate from the plan model) ----------
# The end-of-outing acknowledgement can use a different model, so it doesn't use up your main model's call limit.
# REFLECT_PROVIDER: same (default, uses the model above) | huggingface | openai | anthropic | off
# REFLECT_PROVIDER=huggingface
# HF_TOKEN=hf_...                        # Hugging Face > Settings > Access Tokens
# REFLECT_MODEL=meta-llama/Llama-3.1-8B-Instruct   # any chat model your HF token can use (check HF docs for current names)
# For another provider: REFLECT_PROVIDER=openai with REFLECT_BASE_URL, REFLECT_API_KEY, REFLECT_MODEL
# REFLECT_PROVIDER=off                   # skips the AI and shows built-in text (zero extra calls)
